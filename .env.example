POSTGRES_PASSWORD=replace-with-a-random-hex-password
# Leave empty for named volumes; use absolute paths for server bind mounts.
STUDIO_FILES_PATH=
POSTGRES_DATA_PATH=
# Use placeholder locally and in CI; use tunnel,placeholder for server trials.
COMPOSE_PROFILES=
# Required with the tunnel profile; supplied by the owner, never committed.
TUNNEL_TOKEN=

# Endpoint configuration stays on the server; the browser never receives the key.
IMAGE_API_BASE_URL=http://placeholder:8300/v1
IMAGE_API_KEY=
